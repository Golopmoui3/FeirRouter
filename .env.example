# ---- core ----
FEIR_HOST=127.0.0.1
FEIR_PORT=8081
FEIR_UNIFIED_KEY=
FEIR_MASTER_KEY=change-me-32-chars-minimum!!!
FEIR_DB_PATH=./data/feir.db
# routing: priority|weighted|round-robin|p2c|least-used|random|strict-random|cost-optimized|headroom|reset-window|reset-aware|context-relay|context-optimized|cache-optimized|lkgp|auto|fusion|pipeline|fill-first|failover
FEIR_STRATEGY=auto
FEIR_MAX_ATTEMPTS=20
FEIR_TIMEOUT=300
FEIR_CONCURRENCY=8
# per-tier (идея free-claude-code): fallback + опциональные оверрайды
MODEL=nvidia_nim/stepfun-ai/step-3.5-flash
MODEL_OPUS=
MODEL_SONNET=
MODEL_HAIKU=
MODEL_FABLE=
# compression / optimization
FEIR_COMPRESSION=true
FEIR_PROBES=true
# ---- ключи провайдеров (впиши свои, остальные оставь пустыми) ----
# Полный список префиксов: GET /api/providers или python -m feirrouter doctor
# Free-tier гиганты:
NVIDIA_NIM_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
MISTRAL_CODESTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
ZAI_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
MODELSCOPE_API_KEY=
# Агрегаторы и FCC-экстры:
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=
TOKENROUTER_API_KEY=
NARAROUTE_API_KEY=
WAFER_API_KEY=
OPENCODE_ZEN_API_KEY=
OPENCODE_GO_API_KEY=
# Дешёвые/классика:
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
MINIMAX_API_KEY=
SAMBA_NOVA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
# Подписки (OmniRoute Tier-1, опционально):
CLAUDE_OAUTH_TOKEN=
CODEX_OAUTH_TOKEN=
GEMINI_OAUTH_TOKEN=
# Медиа/поиск/эмбеддинги (опционально):
VOYAGE_API_KEY=
ELEVENLABS_API_KEY=
TAVILY_API_KEY=
# Каталог/защита:
FEIR_CATALOG_PIN=
FEIR_GUARDRAILS=false
FEIR_REQUIRE_AUTH=
